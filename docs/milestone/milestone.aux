\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {System architecture.} Three layers are new in this milestone: \textsc  {(2)}\nobreakspace  {}Character RAG injects persona knowledge, \textsc  {(3)}\nobreakspace  {}LLM + Emotion Arc Tracker turns scene + history into strict JSON emotion annotations, and \textsc  {(5)}\nobreakspace  {}an emotion-aware TTS dispatcher picks the right backend and reference clip. Layers \textsc  {(1)}, \textsc  {(4)} and Phase-1's Qwen3-TTS\,v5 were already in place.\relax }}{2}{figure.caption.1}\protected@file@percent }
